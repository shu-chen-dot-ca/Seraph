# --- GitHub ---------------------------------------------------------------
# Personal access token. A fine-grained token with "Public repositories
# (read-only)" access is enough. Create one at:
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Change these only for GitHub Enterprise Server
# (e.g. https://github.example.com/api/v3 and https://github.example.com/api/graphql).
GITHUB_API_URL=https://api.github.com
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# Seconds to wait for a GitHub response before giving up.
HTTP_TIMEOUT_SECONDS=30

# How many repos to pull from GitHub before applying our own filters
# (commit activity, platform). Higher = better recall, slower, more API cost.
SEARCH_MAX_CANDIDATES=100

# --- Claude (agent) ------------------------------------------------------
# Claude Code subscription token. Create one with:  claude setup-token
# Leave empty to use the Claude Code login already on this machine.
# Do not also set ANTHROPIC_API_KEY: an API key takes priority over this token.
CLAUDE_CODE_OAUTH_TOKEN=

CLAUDE_MODEL=claude-opus-5-5

# Maximum agent turns for one request.
AGENT_MAX_TURNS=30

# --- App -----------------------------------------------------------------
# Port the backend listens on. The frontend dev server reads it from here too.
BACKEND_PORT=8001

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Sandbox -------------------------------------------------------------
# Read by sandbox/*.py and sandbox/image/build.sh. Only the SANDBOX_VM_* values
# are passed into the build VM; nothing else from this file (no tokens) goes in.

# Folder for session records, relative to the project root.
SANDBOX_SESSIONS_DIR=sessions
# Every session VM is named <prefix><id>; this is how we find our VMs.
SANDBOX_VM_PREFIX=session-
# Image new VMs start from: the one sandbox/image/build.sh publishes
SANDBOX_IMAGE=base-image
# Incus profile with the network and egress ACL.
SANDBOX_PROFILE=sandbox
# Incus network of that profile; VM addresses are read from its DHCP leases.
SANDBOX_NETWORK=sandboxbr0
# ACL a VM's network card gets when its internet is turned off (created when first needed).
SANDBOX_OFFLINE_ACL=sandbox-offline
# Per session: the default, and the values the create dialog offers.
SANDBOX_CPUS_DEFAULT=4
SANDBOX_CPUS_ALLOWED=2,4,8
SANDBOX_MEMORY_GB_DEFAULT=4
SANDBOX_MEMORY_GB_ALLOWED=4,8
# Disk must be at least the image's disk (SANDBOX_BUILD_DISK).
SANDBOX_DISK_GB_DEFAULT=40
SANDBOX_DISK_GB_ALLOWED=40,60,80
# Most sessions one click of Create may make.
SANDBOX_CREATE_COUNT_MAX=8
# A VM is not created or started if this machine would have less free RAM than this left.
SANDBOX_MIN_FREE_RAM_GB=8

# Building the image (sandbox/image/build.sh).
SANDBOX_BUILD_FROM=images:ubuntu/24.04/desktop
SANDBOX_BUILD_NAME=base-image
SANDBOX_BUILD_VM=session-image-build
SANDBOX_BUILD_CPUS=8
SANDBOX_BUILD_MEMORY=8GiB
SANDBOX_BUILD_DISK=30GiB

# Layout inside the VM (sandbox/image/provision.sh). The lifecycle code reads
# the same values, so change them together and rebuild the image.
SANDBOX_VM_NODE_MAJOR=24
SANDBOX_VM_FALLBACK_USER=dev
SANDBOX_VM_PY_VENV=/opt/py
SANDBOX_VM_RUST_DIR=/opt/rust
SANDBOX_VM_PLAYWRIGHT_DIR=/opt/playwright
SANDBOX_VM_DEMO_DIR=/opt/demo
# Where the repo is cloned, relative to the desktop user's home.
SANDBOX_VM_PROJECT_DIR=project
SANDBOX_VM_NOVNC_PORT=6080
# ttyd: the terminal in the browser. Each terminal tab is a tmux session.
SANDBOX_VM_TERMINAL_PORT=7681
# File in the VM holding the environment variables set in a session's Settings.
SANDBOX_VM_ENV_FILE=/etc/profile.d/sandbox-env.sh
SANDBOX_VM_VNC_PORT=5900
SANDBOX_VM_DOCKER_IMAGES="postgres:17 redis:7"
